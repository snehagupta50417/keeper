# Copy to .env for development (read by the API server and by Prisma).
# On Cloud Run, pass plain values with --set-env-vars and secrets with --set-secrets
# (Secret Manager's free tier: 6 active secret versions). See docs/CLOUD_SETUP.md.
# Every service here is on a free tier — see docs/FREE_TIER_PLAN.md.

# SQLite. Locally a file in prisma/db; on Cloud Run use file:/tmp/finlegacy.db —
# that data is lost whenever the instance restarts (demo only). The permanent
# database is an open decision (docs/FREE_TIER_PLAN.md §3).
DATABASE_URL="file:./db/dev.db"

# Gemini API key from Google AI Studio (free tier). Free-tier prompts may be used by
# Google to improve its products and read by human reviewers, so send SYNTHETIC data
# only. Without a key the app still works: rule-based intake, local OCR + text rules
# for documents, keyword search with matching passages for questions; drafts are off.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# Tried in order on overload (503/429) or a retired model (404)
# Optional lighter model for live call turns (faster replies). Leave empty to use GEMINI_MODEL.
# GEMINI_AGENT_MODEL="gemini-flash-lite-latest"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-flash-lite-latest"
AI_TIMEOUT_MS="45000"

# Vertex AI instead of an API key — NOT used: Vertex is billed per use (no free tier).
# Leave empty. Only for a future paid setup with real data.
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="asia-south1"

# Embeddings for the case assistant's search (RAG), same free API key.
# Without a key, search is keyword-only.
# Keeper's spoken voice on calls (Gemini text to speech, same free key). If it is unavailable or over
# quota, the browser's own voice is used. Voices: Kore, Puck, Zephyr, Charon, ...
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Kore"

# Speech to text in Indian languages (Sarvam). Optional: without it the browser's own speech recognition is
# used. Free credits on your Sarvam account only; the person's audio is sent to Sarvam for each spoken turn
# (and never stored by Keeper), so the same synthetic-data-only rule applies. Store it with: npm run set-sarvam-key
SARVAM_API_KEY=""
SARVAM_STT_MODEL="saaras:v3"
# "unknown" lets the model detect the language each turn; or force one, e.g. "hi-IN".
SARVAM_LANGUAGE="unknown"

GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMS="768"

# Local OCR (Tesseract, free) for photos and scanned PDFs; works with no AI key.
# Add "tam" for Tamil, e.g. eng+hin+tam. Language data is cached in the temp folder.
OCR_LANGS="eng+hin"
OCR_MAX_PDF_PAGES="5"

# HMAC key for PAN fingerprints (duplicate-deceased detection). Required in production.
PAN_HASH_SECRET=""

# Set to 1 to print every database query while debugging.
# PRISMA_LOG_QUERIES=1

MAX_UPLOAD_MB="8"
RATE_LIMIT_AI_PER_MINUTE="20"

# Local synthetic demo: demo. Hosted deployments always require Supabase.
AUTH_MODE="demo"
# Verify claims console demo (synthetic data). On by default locally; set to 0 to turn it off. Never on when AUTH_MODE=supabase or in production.
CONSOLE_DEMO="1"
# Hosted (AUTH_MODE=supabase) keeps the console off unless this is "public": a public demo of synthetic data only, with desks that expire after a day.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
PUBLIC_APP_URL="http://localhost:3000"
# To use hosted PostgreSQL, set DATABASE_URL to Supabase's session-pooler URL.
# KEEPER_DB_PROVIDER=postgres is needed when generating the hosted client at build time.
# Use npm run db:prepare then npm run db:setup explicitly; startup never modifies the schema.
# Optional secondary credentials, server-only. Existing free credits only.
# Rejected credentials/quota may use this key; primary credentials stay unchanged.
GEMINI_FALLBACK_API_KEY=""
SARVAM_FALLBACK_API_KEY=""
# Gemini reply audio falls back to Sarvam before browser speech.
SARVAM_TTS_MODEL="bulbul:v3"
SARVAM_TTS_VOICE="shubh"
# Open a hosted deployment to anyone with no sign-in (synthetic data only): each browser keeps its own workspace.
# PUBLIC_DEMO="1"
